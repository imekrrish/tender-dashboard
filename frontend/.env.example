# Backend origin used by the frontend at build time.
# Set this in the Vercel project's Environment Variables to your Railway URL.
# Do NOT include a trailing slash or "/api" — the app appends "/api" itself.
#
# Example:
#   VITE_API_URL=https://tender-dashboard-backend.up.railway.app
#
# If unset, the app falls back to http://localhost:5000 for local development.
VITE_API_URL=
